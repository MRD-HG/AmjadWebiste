# Configure in the hosting control panel. This file contains no live secrets.
AMJAD_STORAGE_DIR=/absolute/private/path/amjad-storage
AMJAD_PUBLIC_DATA_DIR=/absolute/document-root/data/cms
AMJAD_UPLOAD_DIR=/absolute/document-root/images/uploads
AMJAD_UPLOAD_URL=/images/uploads
AMJAD_ADMIN_USERNAME=replace-in-host-panel
AMJAD_ADMIN_PASSWORD_HASH=generate-with-password_hash
AMJAD_DEBUG=0

